{
  "name": "pmo-tracker",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local --fail-on error",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > lib/database.types.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tabler/icons-react": "3.31.0",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "next": "16.3.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.14",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.18.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "eslint": "9.35.0",
    "eslint-config-next": "16.3.1",
    "jsdom": "26.1.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "prettier": "3.6.2",
    "supabase": "2.114.0",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.2",
    "vitest": "^3.2.7"
  }
}
